# Pedidos local controlado. No habilitar lecturas/escrituras externas sin una
# fase posterior, credenciales separadas y autorización explícita.
ORDERS_LOCAL_MODE=True
ORDERS_EXTERNAL_READS_ENABLED=False
ORDERS_EXTERNAL_WRITES_ENABLED=False
ORDERS_GUIDE_MAX_BYTES=10485760
LOCAL_DEMO_AUTH_ENABLED=False

# WhatsApp integrado con Pedidos. Mantener las tres compuertas apagadas hasta
# autorizar una prueba explícita contra Meta.
MESSAGING_EXTERNAL_WRITES_ENABLED=False
PAMO_WHATSAPP_EXTERNAL_WRITES_ENABLED=False
PAMO_WHATSAPP_PROVIDER=mock
PAMO_WHATSAPP_AUTO_PREPARE_ENABLED=False
PAMO_WHATSAPP_SUPPLIER_AUTOMATION_ENABLED=False
PAMO_WHATSAPP_GUIDE_AUTO_SEND_ENABLED=False
# Piloto: configurar únicamente el número autorizado; no usar contactos reales.
PAMO_WHATSAPP_PILOT_RECIPIENT=
PAMO_WHATSAPP_PILOT_RECIPIENT_NAME=
PAMO_WHATSAPP_INTERNAL_COPY_FROM=
PAMO_WHATSAPP_INTERNAL_TEMPLATE_VERSION=internal-order-v1
PAMO_WHATSAPP_INTERNAL_ORDER_NOTIFICATIONS_ENABLED=False
PAMO_WHATSAPP_DEPLOYMENT_TIER=local

# Meta Cloud API: nombres previstos solamente; no guardar valores reales aquí.
